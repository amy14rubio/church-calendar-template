# Copy this file to .env.local.
#
# To try the template with NO real Firebase project (see README.md's
# "Try it without a real Firebase project"): leave the placeholder
# values below as-is, keep VITE_USE_FIREBASE_EMULATOR=true, and run
# `firebase emulators:start` alongside `npm run dev`.
#
# To use a real Firebase project instead: set VITE_USE_FIREBASE_EMULATOR
# to false and fill in real values from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-church-calendar.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-church-calendar
VITE_FIREBASE_STORAGE_BUCKET=demo-church-calendar.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Feedback form (header profile menu -> "Enviar comentarios"). Create a
# form at https://formspree.io and paste its endpoint URL. Optional —
# the button just won't do anything useful without it.
VITE_FORMSPREE_FEEDBACK_ENDPOINT=

# Web push notifications (Configuración -> "Avisarme si se cancela un
# evento" — see src/lib/pushNotifications.ts). Only relevant against a
# real Firebase project (Cloud Messaging isn't emulated). Generate this
# in the Firebase console: Project settings -> Cloud Messaging -> Web
# Push certificates -> "Generate key pair".
VITE_FIREBASE_VAPID_KEY=
